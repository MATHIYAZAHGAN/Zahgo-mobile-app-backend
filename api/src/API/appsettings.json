{
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning",
        "Microsoft.Hosting.Lifetime": "Information",
        "System": "Warning"
      }
    }
  },
  "AllowedHosts": "*",
  "Kestrel": {
    "Endpoints": {
      "Http": {
        "Url": "http://0.0.0.0:5000"
      }
    }
  },
  "AI": {
    "BackgroundRemoval": {
      "Provider": "Remove.bg"
    },
    "Gemini": {
      "TextModel": "gemini-2.5-flash",
      "AudioModel": "gemini-2.5-flash"
    }
  },
  "MongoDB": {
    "DatabaseName": "zahgo"
  },
  "JWT": {
    "Issuer": "ZahSellerAI",
    "Audience": "ZahSellerAI-Mobile",
    "AccessTokenExpirationMinutes": 60,
    "RefreshTokenExpirationDays": 30
  }
}

# ============================================
# ZAH Seller AI - Environment Variables Template
# ============================================
# Copy this file to .env and fill in your actual values
# NEVER commit the .env file to Git!

# Gemini AI Configuration
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_IMAGE_MODEL=gemini-3.1-flash-image
AI__Gemini__TextModel=gemini-2.5-flash
AI__Gemini__AudioModel=gemini-2.5-flash

# Remove.bg API Configuration (Professional background removal)
REMOVEBG_API_KEY=your_removebg_api_key_here

# MongoDB Atlas Configuration (Live Database)
MONGODB_CONNECTION_STRING=mongodb://localhost:27017
MONGODB_DATABASE_NAME=your_database_name

# Public API origin used to create seller-visible photo URLs.
# Use the API host reachable by the seller's phone/browser, not localhost in production.
Storage__LocalBaseUrl=https://api.example.com

# JWT Configuration
JWT_SECRET=your_secure_jwt_secret_at_least_32_characters
JWT_ISSUER=ZahSellerAI
JWT_AUDIENCE=ZahSellerAI-Mobile

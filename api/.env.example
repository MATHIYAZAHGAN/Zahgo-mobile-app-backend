# Application
APP_NAME=ZahSellerAI
ENVIRONMENT=Development
API_VERSION=v1
API_PORT=5000

# Database
MONGODB_CONNECTION_STRING=mongodb://localhost:27017
MONGODB_DATABASE_NAME=zahsellerai

# JWT Authentication
JWT_SECRET=your-super-secret-jwt-key-change-in-production
JWT_ISSUER=ZahSellerAI
JWT_AUDIENCE=ZahSellerAI-Mobile
JWT_ACCESS_TOKEN_EXPIRY_MINUTES=60
JWT_REFRESH_TOKEN_EXPIRY_DAYS=30

# AI Providers
# OpenAI
OPENAI_API_KEY=your-openai-api-key
OPENAI_MODEL=gpt-4-vision-preview
OPENAI_WHISPER_MODEL=whisper-1

# Alternative: Azure OpenAI
AZURE_OPENAI_ENDPOINT=https://your-resource.openai.azure.com/
AZURE_OPENAI_API_KEY=your-azure-openai-key
AZURE_OPENAI_DEPLOYMENT_NAME=gpt-4-vision

# Cloud Storage
# AWS S3
AWS_ACCESS_KEY_ID=your-aws-access-key
AWS_SECRET_ACCESS_KEY=your-aws-secret-key
AWS_REGION=ap-south-1
AWS_S3_BUCKET=zahsellerai-products

# Alternative: Azure Blob Storage
AZURE_STORAGE_CONNECTION_STRING=your-azure-storage-connection-string
AZURE_STORAGE_CONTAINER=product-images

# CORS
CORS_ORIGINS=http://localhost:3000,http://localhost:19006

# Rate Limiting
RATE_LIMIT_REQUESTS_PER_MINUTE=60

# File Upload
MAX_FILE_SIZE_MB=10
ALLOWED_IMAGE_TYPES=image/jpeg,image/png,image/webp
ALLOWED_AUDIO_TYPES=audio/wav,audio/mp3,audio/m4a,audio/webm

# Background Jobs
REDIS_CONNECTION_STRING=localhost:6379
ENABLE_BACKGROUND_JOBS=true

# Logging
LOG_LEVEL=Information
SERILOG_MINIMUM_LEVEL=Information

# External Services
# SMS Provider (for OTP)
SMS_PROVIDER=twilio
TWILIO_ACCOUNT_SID=your-twilio-account-sid
TWILIO_AUTH_TOKEN=your-twilio-auth-token
TWILIO_PHONE_NUMBER=+1234567890

# Email Provider
EMAIL_PROVIDER=sendgrid
SENDGRID_API_KEY=your-sendgrid-api-key
SENDGRID_FROM_EMAIL=noreply@zahsellerai.com
SENDGRID_FROM_NAME=ZAH Seller AI

# Push Notifications
FIREBASE_PROJECT_ID=your-firebase-project-id
FIREBASE_PRIVATE_KEY=your-firebase-private-key
FIREBASE_CLIENT_EMAIL=your-firebase-client-email

# Application Insights / Monitoring
APPLICATIONINSIGHTS_CONNECTION_STRING=your-app-insights-connection-string

# Feature Flags
ENABLE_AI_IMAGE_ENHANCEMENT=true
ENABLE_BACKGROUND_REMOVAL=true
ENABLE_AUTO_CATEGORY_CLASSIFICATION=true
ENABLE_DEMO_MODE=false

# Security
ENABLE_RATE_LIMITING=true
ENABLE_HTTPS_REDIRECT=true
ENABLE_HSTS=true
